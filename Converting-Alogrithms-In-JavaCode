    public static void main(String args[]) {
        int[] arr = {1, 2, 3, 2, 4, 3, 5}; // Example array
        int[] result = findDuplicates(arr);
        
        // Print results
        for (int i = 0; i < result.length; i++) {
            if (result[i] != 0) {
                System.out.println(result[i]);
            }
        }
    }
    
    public static int[] findDuplicates(int[] arr) {
        int[] result = new int[arr.length]; // ✅ Correct array syntax
        int duplicateCount = 0;
        
        for (int i = 0; i < arr.length; i++) {
            for (int j = i + 1; j < arr.length; j++) { // ✅ Start j from i+1
                if (arr[i] == arr[j]) {
                    // Check if already added to avoid duplicates in result
                    boolean alreadyAdded = false;
                    for (int k = 0; k < duplicateCount; k++) {
                        if (result[k] == arr[i]) {
                            alreadyAdded = true;
                            break;
                        }
                    }
                    
                    if (!alreadyAdded) {
                        result[duplicateCount] = arr[i]; // ✅ Use = not ==
                        duplicateCount++;
                    }
                    break; // Found duplicate, move to next i
                }
            }
        }
        
        return result; // ✅ Return array, not count
    }
}   


